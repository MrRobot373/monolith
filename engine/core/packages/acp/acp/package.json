{
  "name": "@monolith/acp",
  "description": "Automation-only Agent Client Protocol server for driving MONOLITH agents over JSON-RPC stdio",
  "version": "0.1.2-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MrRobot373/monolith.git",
    "directory": "packages/acp/acp"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@agentclientprotocol/sdk": "1.4.0",
    "@monolith/brand": "workspace:^",
    "@monolith/schemastery": "workspace:^"
  },
  "peerDependencies": {
    "@monolith/cordis": "workspace:^",
    "@monolith/agent": "workspace:^",
    "@monolith/attachment": "workspace:^",
    "@monolith/llm": "workspace:^",
    "@monolith/mcp-client": "workspace:^",
    "@monolith/session": "workspace:^",
    "@monolith/session-persistence": "workspace:^",
    "@monolith/token-meter": "workspace:^",
    "@monolith/user-approval": "workspace:^"
  },
  "peerDependenciesMeta": {
    "@monolith/token-meter": {
      "optional": true
    }
  },
  "devDependencies": {
    "@monolith/cordis": "workspace:^",
    "@monolith/agent": "workspace:^",
    "@monolith/agent-loop": "workspace:^",
    "@monolith/agent-loop-testkit": "workspace:^",
    "@monolith/attachment": "workspace:^",
    "@monolith/llm": "workspace:^",
    "@monolith/mcp-client": "workspace:^",
    "@monolith/session": "workspace:^",
    "@monolith/session-persistence": "workspace:^",
    "@monolith/session-persistence-jsonl": "workspace:^",
    "@monolith/session-projection": "workspace:^",
    "@monolith/token-meter": "workspace:^",
    "@monolith/tools": "workspace:^",
    "@monolith/user-approval": "workspace:^"
  }
}
