{
  "name": "@monolith/client-ui-brand",
  "description": "MONOLITH brand occupants for the monolith Web client's sidebar and conversation-hero slots",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "monolith": {
    "client": {
      "inject": [
        "@monolith/client-ui-conversation",
        "@monolith/client-ui-renderer",
        "@monolith/client-ui-sidebar",
        "@monolith/client-ui-theme"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "peerDependencies": {
    "@monolith/cordis": "workspace:^"
  },
  "devDependencies": {
    "@monolith/client-ui-conversation": "workspace:^",
    "@monolith/client-ui-renderer": "workspace:^",
    "@monolith/client-ui-sidebar": "workspace:^",
    "@monolith/client-ui-theme": "workspace:^",
    "@monolith/cordis": "workspace:^",
    "@testing-library/react": "^16.1.0",
    "@types/react": "~18.3.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ]
}
