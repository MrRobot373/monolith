{
  "name": "@monolith/fs-observation-policy",
  "description": "File-context policy plugin for the MONOLITH — observed-state, read-before-edit, and version-guarded write/edit added over the ctx.fs provider seam through the fs/* event gate (no service API)",
  "version": "0.1.2-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MrRobot373/monolith.git",
    "directory": "packages/fs/fs-observation-policy"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@monolith/fs": "workspace:^",
    "@monolith/cordis": "workspace:^"
  },
  "devDependencies": {
    "@monolith/fs": "workspace:^",
    "@monolith/llm": "workspace:^",
    "@monolith/cordis": "workspace:^"
  }
}
