{
  "name": "@monolith/message-feedback",
  "description": "Lifecycle-bound per-message rating and note sidecar for the MONOLITH",
  "version": "0.1.2-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MrRobot373/monolith.git",
    "directory": "packages/feedback/message-feedback"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@monolith/brand": "workspace:^",
    "@monolith/llm": "workspace:^",
    "@monolith/session": "workspace:^",
    "@monolith/session-persistence": "workspace:^",
    "@monolith/storage-domain": "workspace:^",
    "@monolith/typert-protocol": "workspace:^",
    "@monolith/cordis": "workspace:^"
  },
  "dependencies": {
    "@monolith/schemastery": "workspace:^",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@monolith/cordis-plugin-include": "workspace:^",
    "@monolith/cordis-plugin-loader": "workspace:^",
    "@monolith/brand": "workspace:^",
    "@monolith/llm": "workspace:^",
    "@monolith/session": "workspace:^",
    "@monolith/session-persistence": "workspace:^",
    "@monolith/session-persistence-jsonl": "workspace:^",
    "@monolith/storage": "workspace:^",
    "@monolith/storage-domain": "workspace:^",
    "@monolith/storage-json": "workspace:^",
    "@monolith/typert-protocol": "workspace:^",
    "@monolith/cordis": "workspace:^"
  }
}
