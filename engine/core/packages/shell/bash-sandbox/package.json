{
  "name": "@monolith/bash-sandbox",
  "description": "Sandbox-consuming implementation of the MONOLITH bash executor seam (confines every command via ctx.sandbox, reports denial/enforcement result facts)",
  "version": "0.1.2-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MrRobot373/monolith.git",
    "directory": "packages/shell/bash-sandbox"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@monolith/shell": "workspace:^",
    "@monolith/bash-local": "workspace:^",
    "@monolith/sandbox": "workspace:^",
    "@monolith/sandbox-policy": "workspace:^",
    "@monolith/cordis": "workspace:^"
  },
  "devDependencies": {
    "@monolith/shell": "workspace:^",
    "@monolith/bash-local": "workspace:^",
    "@monolith/subprocess-local": "workspace:^",
    "@monolith/sandbox": "workspace:^",
    "@monolith/sandbox-local": "workspace:^",
    "@monolith/sandbox-policy": "workspace:^",
    "@monolith/cordis": "workspace:^",
    "@monolith/node-addon-landlock-run": "workspace:^",
    "@monolith/session-projection": "workspace:^"
  }
}
