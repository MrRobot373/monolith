{
  "name": "@monolith/tool-web",
  "description": "Model-facing web tools (web_search, web_fetch) over the MONOLITH web capability seam (ctx.web)",
  "version": "0.1.2-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MrRobot373/monolith.git",
    "directory": "packages/web/tool-web"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@monolith/cordis": "workspace:^",
    "@monolith/llm": "workspace:^",
    "@monolith/system-prompt": "workspace:^",
    "@monolith/tools": "workspace:^",
    "@monolith/web": "workspace:^"
  },
  "dependencies": {
    "@monolith/util-values": "workspace:^",
    "@monolith/schemastery": "workspace:^",
    "@joplin/turndown-plugin-gfm": "^1.0.67",
    "turndown": "^7.2.4"
  },
  "devDependencies": {
    "@monolith/cordis": "workspace:^",
    "@monolith/agent": "workspace:^",
    "@monolith/llm": "workspace:^",
    "@monolith/session": "workspace:^",
    "@monolith/spill-local": "workspace:^",
    "@monolith/spill-policy": "workspace:^",
    "@monolith/system-prompt": "workspace:^",
    "@monolith/tool-call-timeout-policy": "workspace:^",
    "@monolith/tools": "workspace:^",
    "@monolith/web": "workspace:^",
    "@monolith/web-fetch-http": "workspace:^",
    "@monolith/web-search-exa": "workspace:^",
    "@types/turndown": "^5.0.6"
  }
}
