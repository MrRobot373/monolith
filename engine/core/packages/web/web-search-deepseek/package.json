    "@monolith/cordis": "workspace:^",
    "@monolith/settings": "workspace:^"
  },
  "dependencies": {
    "@monolith/schemastery": "workspace:^"
  },
  "devDependencies": {
    "@monolith/agent": "workspace:^",
    "@monolith/credentials": "workspace:^",
    "@monolith/credentials-local": "workspace:^",
    "@monolith/launch-environment": "workspace:^",
    "@monolith/session": "workspace:^",
    "@monolith/web": "workspace:^",
    "@monolith/cordis": "workspace:^",
    "@monolith/settings": "workspace:^",
    "@monolith/http-proxy": "workspace:^"
  }
