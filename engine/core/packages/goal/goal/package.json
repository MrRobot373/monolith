{
  "name": "@monolith/goal",
  "description": "Event-sourced same-session goal state and lifecycle service for the MONOLITH",
  "version": "0.1.2-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MrRobot373/monolith.git",
    "directory": "packages/goal/goal"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./client": {
      "types": "./lib/types/client.d.ts",
      "default": "./lib/types/client.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@monolith/agent": "workspace:^",
    "@monolith/session-projection": "workspace:^",
    "@monolith/brand": "workspace:^",
    "@monolith/invariants": "workspace:^",
    "@monolith/llm": "workspace:^",
    "@monolith/scope": "workspace:^",
    "@monolith/session": "workspace:^",
    "@monolith/typert-protocol": "workspace:^",
    "@monolith/cordis": "workspace:^"
  },
  "dependencies": {
    "@monolith/schemastery": "workspace:^",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@monolith/agent": "workspace:^",
    "@monolith/bash-local": "workspace:^",
    "@monolith/session-projection": "workspace:^",
    "@monolith/brand": "workspace:^",
    "@monolith/invariants": "workspace:^",
    "@monolith/llm": "workspace:^",
    "@monolith/loader-smoke": "workspace:^",
    "@monolith/scope": "workspace:^",
    "@monolith/session": "workspace:^",
    "@monolith/session-checkpoint-policy": "workspace:^",
    "@monolith/session-persistence-jsonl": "workspace:^",
    "@monolith/subprocess-local": "workspace:^",
    "@monolith/typert-protocol": "workspace:^",
    "@monolith/cordis": "workspace:^"
  }
}
