{
  "name": "@monolith/sdk-jsonrpc-server",
  "description": "Stdio JSON-RPC server plugin for out-of-process MONOLITH SDK clients",
  "version": "0.1.2-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MrRobot373/monolith.git",
    "directory": "packages/sdk/server"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@monolith/brand": "workspace:^",
    "@monolith/schemastery": "workspace:^"
  },
  "peerDependencies": {
    "@monolith/cordis": "workspace:^",
    "@monolith/agent": "workspace:^",
    "@monolith/attachment": "workspace:^",
    "@monolith/llm": "workspace:^",
    "@monolith/llm-deepseek": "workspace:^",
    "@monolith/scope": "workspace:^",
    "@monolith/sdk-protocol": "workspace:^",
    "@monolith/session": "workspace:^",
    "@monolith/subagent": "workspace:^"
  },
  "devDependencies": {
    "@monolith/cordis": "workspace:^",
    "@monolith/cordis-plugin-loader": "workspace:^",
    "@monolith/agent": "workspace:^",
    "@monolith/agent-loop": "workspace:^",
    "@monolith/agent-loop-testkit": "workspace:^",
    "@monolith/attachment": "workspace:^",
    "@monolith/llm": "workspace:^",
    "@monolith/llm-deepseek": "workspace:^",
    "@monolith/scope": "workspace:^",
    "@monolith/sdk-protocol": "workspace:^",
    "@monolith/session": "workspace:^",
    "@monolith/session-persistence-jsonl": "workspace:^",
    "@monolith/session-projection": "workspace:^",
    "@monolith/subagent": "workspace:^"
  }
}
