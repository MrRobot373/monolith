{
  "name": "@monolith/credentials-local",
  "description": "File-backed credentials provider ($MONOLITH_HOME/.env under the live process environment) for the MONOLITH",
  "version": "0.1.2-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MrRobot373/monolith.git",
    "directory": "packages/credentials/credentials-local"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@monolith/atomic-write": "workspace:^",
    "@monolith/credentials": "workspace:^",
    "@monolith/launch-environment": "workspace:^",
    "@monolith/home-paths": "workspace:^",
    "@monolith/cordis": "workspace:^"
  },
  "dependencies": {
    "chokidar": "^4.0.3",
    "@monolith/schemastery": "workspace:^",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@monolith/atomic-write": "workspace:^",
    "@monolith/credentials": "workspace:^",
    "@monolith/launch-environment": "workspace:^",
    "@monolith/home-paths": "workspace:^",
    "@monolith/cordis": "workspace:^"
  }
}
