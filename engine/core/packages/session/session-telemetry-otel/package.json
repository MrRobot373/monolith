{
  "name": "@monolith/session-telemetry-otel",
  "description": "OpenTelemetry backend for the MONOLITH telemetry seam: hands captured session records to the OTel JS SDK's log pipeline",
  "version": "0.1.2-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MrRobot373/monolith.git",
    "directory": "packages/session/session-telemetry-otel"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/api-logs": "^0.220.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.220.0",
    "@opentelemetry/otlp-exporter-base": "^0.220.0",
    "@opentelemetry/resources": "^2.9.0",
    "@opentelemetry/sdk-logs": "^0.220.0",
    "@monolith/schemastery": "workspace:^"
  },
  "peerDependencies": {
    "@monolith/command-feedback": "workspace:^",
    "@monolith/llm": "workspace:^",
    "@monolith/session": "workspace:^",
    "@monolith/session-telemetry": "workspace:^",
    "@monolith/anonymous-user-id": "workspace:^",
    "@monolith/cordis": "workspace:^"
  },
  "devDependencies": {
    "@monolith/cordis-plugin-logger-console": "workspace:^",
    "@monolith/cordis-plugin-loader": "workspace:^",
    "@monolith/app-boot": "workspace:^",
    "@monolith/bash-local": "workspace:^",
    "@monolith/command-feedback": "workspace:^",
    "@monolith/llm": "workspace:^",
    "@monolith/loader-smoke": "workspace:^",
    "@monolith/session": "workspace:^",
    "@monolith/session-checkpoint-policy": "workspace:^",
    "@monolith/session-persistence-jsonl": "workspace:^",
    "@monolith/session-telemetry": "workspace:^",
    "@monolith/subprocess-local": "workspace:^",
    "@monolith/anonymous-user-id": "workspace:^",
    "@monolith/cordis": "workspace:^",
    "@monolith/http-proxy": "workspace:^"
  }
}
