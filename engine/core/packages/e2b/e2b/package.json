    "@monolith/loader-smoke": "workspace:^",
    "@monolith/lsp": "workspace:^",
    "@monolith/lsp-stdio": "workspace:^",
    "@monolith/sandbox-policy": "workspace:^",
    "@monolith/session": "workspace:^",
    "@monolith/session-projection": "workspace:^",
    "@monolith/subprocess-e2b": "workspace:^",
    "@monolith/terminal": "workspace:^",
    "@monolith/terminal-bash": "workspace:^",
    "@monolith/http-proxy": "workspace:^",
    "@monolith/launch-environment": "workspace:^"
  }
