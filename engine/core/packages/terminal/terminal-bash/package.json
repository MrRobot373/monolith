{
  "name": "@monolith/terminal-bash",
  "description": "Persistent shell PTY backend over the MONOLITH subprocess terminal primitive",
  "version": "0.1.2-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MrRobot373/monolith.git",
    "directory": "packages/terminal/terminal-bash"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@monolith/agent": "workspace:^",
    "@monolith/terminal": "workspace:^",
    "@monolith/sandbox": "workspace:^",
    "@monolith/sandbox-policy": "workspace:^",
    "@monolith/session": "workspace:^",
    "@monolith/subprocess": "workspace:^",
    "@monolith/cordis": "workspace:^",
    "@monolith/session-projection": "workspace:^"
  },
  "dependencies": {
    "@monolith/pwsh-local": "workspace:^",
    "@monolith/schemastery": "workspace:^",
    "@xterm/headless": "^6.0.0"
  },
  "devDependencies": {
    "@monolith/agent": "workspace:^",
    "@monolith/terminal": "workspace:^",
    "@monolith/sandbox": "workspace:^",
    "@monolith/sandbox-policy": "workspace:^",
    "@monolith/session": "workspace:^",
    "@monolith/subprocess": "workspace:^",
    "@monolith/subprocess-local": "workspace:^",
    "@monolith/cordis": "workspace:^"
  }
}
