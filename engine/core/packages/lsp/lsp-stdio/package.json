{
  "name": "@monolith/lsp-stdio",
  "description": "Generic stdio language-server provider for the MONOLITH LSP capability seam (ctx.lsp) — spawns configured servers, translates JSON-RPC, and serves transient-open goToDefinition/findReferences/goToImplementation/hover queries in the host filesystem namespace",
  "version": "0.1.2-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MrRobot373/monolith.git",
    "directory": "packages/lsp/lsp-stdio"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@monolith/cordis": "workspace:^",
    "@monolith/brand": "workspace:^",
    "@monolith/fs": "workspace:^",
    "@monolith/llm": "workspace:^",
    "@monolith/lsp": "workspace:^",
    "@monolith/subprocess": "workspace:^",
    "@monolith/timeout": "workspace:^"
  },
  "dependencies": {
    "@monolith/util-values": "workspace:^",
    "@monolith/schemastery": "workspace:^"
  },
  "devDependencies": {
    "@monolith/cordis": "workspace:^",
    "@monolith/brand": "workspace:^",
    "@monolith/fs": "workspace:^",
    "@monolith/fs-local": "workspace:^",
    "@monolith/llm": "workspace:^",
    "@monolith/lsp": "workspace:^",
    "@monolith/subprocess": "workspace:^",
    "@monolith/subprocess-local": "workspace:^",
    "@monolith/timeout": "workspace:^",
    "typescript": "^6.0.3",
    "typescript-language-server": "^5.0.0"
  }
}
