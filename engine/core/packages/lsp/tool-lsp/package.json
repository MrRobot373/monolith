{
  "name": "@monolith/tool-lsp",
  "description": "Model-facing lsp tool over the MONOLITH LSP capability seam (ctx.lsp) — one read-only tool with goToDefinition/findReferences/goToImplementation/hover operations, one-based UTF-16 cursor coordinates, bounded location rendering, and hover normalization",
  "version": "0.1.2-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MrRobot373/monolith.git",
    "directory": "packages/lsp/tool-lsp"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@monolith/cordis": "workspace:^",
    "@monolith/llm": "workspace:^",
    "@monolith/lsp": "workspace:^",
    "@monolith/system-prompt": "workspace:^",
    "@monolith/timeout": "workspace:^",
    "@monolith/tools": "workspace:^"
  },
  "dependencies": {
    "@monolith/util-values": "workspace:^",
    "@monolith/schemastery": "workspace:^"
  },
  "devDependencies": {
    "@monolith/cordis": "workspace:^",
    "@monolith/agent": "workspace:^",
    "@monolith/fs-local": "workspace:^",
    "@monolith/llm": "workspace:^",
    "@monolith/lsp": "workspace:^",
    "@monolith/lsp-stdio": "workspace:^",
    "@monolith/session": "workspace:^",
    "@monolith/subprocess-local": "workspace:^",
    "@monolith/system-prompt": "workspace:^",
    "@monolith/timeout": "workspace:^",
    "@monolith/tool-call-timeout-policy": "workspace:^",
    "@monolith/tools": "workspace:^"
  }
}
