{
  "name": "@monolith/client-connection",
  "description": "Authenticated RPC transport, generation lifecycle, and browser fixture",
  "version": "0.1.2-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MrRobot373/monolith.git",
    "directory": "packages/client/connection"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "monolith": {
    "client": {
      "inject": [],
      "platform": "web",
      "immediately": true
    }
  },
  "license": "MIT",
  "dependencies": {
    "@monolith/credentials": "workspace:^",
    "@monolith/schemastery": "workspace:^",
    "zod": "^4.4.3"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ],
  "peerDependencies": {
    "@monolith/cordis": "workspace:^"
  },
  "devDependencies": {
    "@monolith/cordis": "workspace:^",
    "@monolith/attachment": "workspace:^",
    "@monolith/brand": "workspace:^",
    "@monolith/commands": "workspace:^",
    "@monolith/host-directory-picker": "workspace:^",
    "@monolith/host-webserver": "workspace:^",
    "@monolith/llm": "workspace:^",
    "@monolith/session": "workspace:^",
    "@monolith/settings": "workspace:^",
    "@monolith/tool-todo": "workspace:^",
    "@monolith/util-values": "workspace:^"
  }
}
