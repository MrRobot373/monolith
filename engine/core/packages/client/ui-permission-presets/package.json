{
  "name": "@monolith/client-ui-permission-presets",
  "description": "Permission surfaces: a new-session default in General settings and a current-session /permission popup over the permissions projection",
  "version": "0.1.2-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MrRobot373/monolith.git",
    "directory": "packages/client/ui-permission-presets"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "monolith": {
    "client": {
      "inject": [
        "@monolith/api-session-controller",
        "@monolith/client-locale",
        "@monolith/client-ui-commands",
        "@monolith/api-remotes",
        "@monolith/client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "peerDependencies": {
    "@monolith/cordis": "workspace:^"
  },
  "devDependencies": {
    "@monolith/cordis": "workspace:^",
    "@monolith/api-remotes": "workspace:^",
    "@monolith/api-session-controller": "workspace:^",
    "@monolith/client-locale": "workspace:^",
    "@monolith/client-store": "workspace:^",
    "@monolith/client-test-runtime": "workspace:^",
    "@monolith/client-ui-commands": "workspace:^",
    "@monolith/client-ui-primitives": "workspace:^",
    "@monolith/client-ui-settings": "workspace:^",
    "@monolith/client-ui-input-trigger": "workspace:^",
    "@monolith/client-ui-slots": "workspace:^",
    "@monolith/permission-presets": "workspace:^",
    "@types/react": "~18.3.1",
    "react": "^18.2.0",
    "@monolith/client-ui-renderer": "workspace:^",
    "@monolith/client-ui-session": "workspace:^"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ]
}
