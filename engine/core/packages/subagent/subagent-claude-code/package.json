{
  "name": "@monolith/subagent-claude-code",
  "description": "One-shot Claude Code subagent provider over the official Agent SDK",
  "version": "0.1.2-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MrRobot373/monolith.git",
    "directory": "packages/subagent/subagent-claude-code"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "cordis.patch.yml",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "monolith": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@monolith/cordis": "workspace:^",
    "@monolith/llm": "workspace:^",
    "@monolith/session": "workspace:^",
    "@monolith/subagent": "workspace:^",
    "@monolith/subprocess": "workspace:^",
    "@monolith/timeout": "workspace:^"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.241",
    "@anthropic-ai/sdk": "0.93.0",
    "@monolith/brand": "workspace:^",
    "@monolith/schemastery": "workspace:^",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@monolith/cordis": "workspace:^",
    "@monolith/agent": "workspace:^",
    "@monolith/app-boot": "workspace:^",
    "@monolith/llm": "workspace:^",
    "@monolith/loader-smoke": "workspace:^",
    "@monolith/session": "workspace:^",
    "@monolith/session-checkpoint-policy": "workspace:^",
    "@monolith/session-persistence-jsonl": "workspace:^",
    "@monolith/session-projection": "workspace:^",
    "@monolith/subagent": "workspace:^",
    "@monolith/subagent-codex": "workspace:^",
    "@monolith/subprocess": "workspace:^",
    "@monolith/subprocess-local": "workspace:^",
    "@monolith/timeout": "workspace:^",
    "@monolith/tool-jobs": "workspace:^",
    "@monolith/tool-subagent": "workspace:^",
    "@monolith/tools": "workspace:^"
  }
}
