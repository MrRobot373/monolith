{
  "name": "@monolith/subagent-monolith-sdk",
  "description": "Out-of-process SDK subagent backend: drives a child MONOLITH runtime subprocess over stdio JSON-RPC through the TypeScript SDK client",
  "version": "0.1.2-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MrRobot373/monolith.git",
    "directory": "packages/subagent/subagent-monolith-sdk"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@monolith/cordis": "workspace:^",
    "@monolith/agent": "workspace:^",
    "@monolith/llm": "workspace:^",
    "@monolith/sdk-client": "workspace:^",
    "@monolith/session": "workspace:^",
    "@monolith/subagent": "workspace:^",
    "@monolith/subprocess": "workspace:^"
  },
  "dependencies": {
    "@monolith/brand": "workspace:^",
    "@monolith/schemastery": "workspace:^"
  },
  "devDependencies": {
    "@monolith/cordis": "workspace:^",
    "@monolith/cordis-plugin-loader": "workspace:^",
    "@monolith/agent": "workspace:^",
    "@monolith/agent-instructions": "workspace:^",
    "@monolith/app-boot": "workspace:^",
    "@monolith/llm": "workspace:^",
    "@monolith/llm-deepseek": "workspace:^",
    "@monolith/loader-smoke": "workspace:^",
    "@monolith/sdk-client": "workspace:^",
    "@monolith/sdk-protocol": "workspace:^",
    "@monolith/session": "workspace:^",
    "@monolith/session-checkpoint-policy": "workspace:^",
    "@monolith/session-persistence-jsonl": "workspace:^",
    "@monolith/session-projection": "workspace:^",
    "@monolith/skill-filesystem": "workspace:^",
    "@monolith/subagent": "workspace:^",
    "@monolith/subprocess": "workspace:^",
    "@monolith/system-prompt": "workspace:^",
    "@monolith/tool-subagent": "workspace:^"
  }
}
