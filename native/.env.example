# ============================================================================
# MONOLITH — native (no-Docker) OpenWork launcher config.
# Copy to `native\.env` and fill in. This file is committed; `.env` is NOT.
# Generate a token with:  node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# ============================================================================

# ---- Engine: OUR orchestrator on vendored opencode (default) ---------------
# MONOLITH_ENGINE=own (default) runs monolith-server/orchestrator.mjs, which
# drives OUR vendored opencode engine (engine/opencode, cloned by setup.cmd)
# from source via bun — no prebuilt/unsigned binary, so it isn't subject to
# Windows Smart App Control blocking it. Set MONOLITH_ENGINE=legacy to fall
# back to the old openwork-orchestrator prebuilt binary instead.
MONOLITH_ENGINE=own
# OPENCODE_DIR=C:\Users\Yash\Downloads\MONOLITH\engine\opencode

# ---- OpenWork engine (openwork-server + opencode) --------------------------
# Shared secret between the built UI and the local engine (any random string).
# Only used by MONOLITH_ENGINE=legacy today — the orchestrator doesn't check
# these yet (native is localhost-only single-user; tracked for a later phase).
OPENWORK_TOKEN=change-me-client-token
OPENWORK_HOST_TOKEN=change-me-host-token
# Where the agent does its work (files it reads/writes). Default: native\workspace
# OPENWORK_WORKSPACE=C:\Users\Yash\Downloads\MONOLITH\native\workspace

# Ports (change only if something else already uses them).
OPENWORK_PORT=8787
OPENCODE_PORT=4096
UI_PORT=8080

# Repoint the OpenCode model catalog off OpenWork's mirror to the public default.
OPENCODE_MODELS_URL=https://models.dev/

# Pin the published orchestrator (0.17.8 is the known-good published version).
# Only used by MONOLITH_ENGINE=legacy.
ORCHESTRATOR_VERSION=0.17.8

# ---- OpenRouter (optional cloud model provider) ----------------------------
# SECURITY: real keys go in native\.env only. Rotate keys that were pasted into
# chat or screenshots.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openrouter/auto
OPENROUTER_AS_DEFAULT=1
# Discover zero-cost OpenRouter text models, probe them, and write only the
# currently working free models into opencode.json.
OPENROUTER_FREE_ONLY=0
# Hide local/cloud/gateway providers from the generated picker config.
OPENROUTER_ONLY=0
# Optional comma-separated allowlist shown in the picker, for example:
# OPENROUTER_MODELS=openrouter/auto,anthropic/claude-sonnet-4.5,openai/gpt-5.2

# ---- Supabase auth ---------------------------------------------------------
# Public browser config. Prefer a Supabase publishable key. Legacy anon keys
# are still supported for existing projects.
VITE_SUPABASE_URL=https://eawjpzhtkmuunucdhcdo.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_ANON_KEY=
VITE_MONOLITH_REQUIRE_SIGNIN=1

# Server-side protection for /__monolith/* routes. Uses the same Supabase
# project to verify Bearer tokens sent by the browser.
SUPABASE_URL=https://eawjpzhtkmuunucdhcdo.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_ANON_KEY=
MONOLITH_REQUIRE_AUTH=1

# Optional: comma-separated emails allowed to edit org settings and view usage.
# Blank means every signed-in user is treated as admin for single-user installs.
MONOLITH_ADMIN_EMAILS=

# ---- Local Ollama (default, private, no keys) ------------------------------
OLLAMA_URL=http://localhost:11434/v1
# The model pulled + used as the default. Pick one you can run on this PC.
OLLAMA_MODEL=qwen2.5-coder:7b

# ---- Smart model router (cost-saving auto-routing) -------------------------
# A tiny local model classifies each chat message as SIMPLE or COMPLEX, so
# simple messages go to a cheap small model and complex ones to the smartest
# available model — instead of always paying for the biggest. On any classifier
# failure it falls back to a keyword heuristic biased toward the large model, so
# it never silently downgrades a hard task. Applies to the MONOLITH chat surface
# (/chat), not the OpenCode agent sessions.
MONOLITH_ROUTER_ENABLED=1
# Cheap/fast model for simple messages. Also the default classifier.
# Pull it once:  ollama pull qwen2.5:0.5b
MONOLITH_ROUTER_SMALL_MODEL=qwen2.5:0.5b
MONOLITH_ROUTER_SMALL_PROVIDER=ollama
# Smartest tier. Blank = auto-resolve: OpenRouter's OPENROUTER_MODEL if a key is
# set, else the LiteLLM gateway, else OLLAMA_MODEL on a single-model box.
MONOLITH_ROUTER_LARGE_MODEL=
MONOLITH_ROUTER_LARGE_PROVIDER=
# Classifier model. Blank = reuse the small model above.
MONOLITH_ROUTER_CLASSIFIER_MODEL=
MONOLITH_ROUTER_CLASSIFIER_PROVIDER=
# Classifier request timeout (ms) and max output tokens (one word is enough).
MONOLITH_ROUTER_CLASSIFIER_TIMEOUT_MS=4000
MONOLITH_ROUTER_CLASSIFIER_MAX_TOKENS=4
# How long the discovered local-model list is cached (ms).
MONOLITH_ROUTER_MODELS_CACHE_MS=60000

# ---- Ollama Cloud pool (optional big-model fallback) -----------------------
# The local round-robin proxy rotates these keys across OLLAMA_POOL_BASE.
# Leave all blank to disable the cloud pool entirely (local Ollama still works).
# SECURITY: real keys go in native\.env only — never commit them.
POOL_PORT=11435
OLLAMA_POOL_BASE=https://ollama.com/v1
OLLAMA_POOL_MODEL=gpt-oss:120b
OLLAMA_KEY_1=
OLLAMA_KEY_2=
OLLAMA_KEY_3=
OLLAMA_KEY_4=
OLLAMA_KEY_5=
OLLAMA_KEY_6=
OLLAMA_KEY_7=
OLLAMA_KEY_8=
OLLAMA_KEY_9=
OLLAMA_KEY_10=
OLLAMA_KEY_11=
OLLAMA_KEY_12=
OLLAMA_KEY_13=
OLLAMA_KEY_14=

# ---- Optional branding -----------------------------------------------------
# Set to rebrand the browser tab title (blank = keep "OpenWork").
PRODUCT_NAME=

# ---- Agent tools: MCP servers (seeded into each workspace's opencode.json) --
# Web search backend for the built-in monolith-web MCP. Blank = DuckDuckGo
# HTML (no key). Point at a self-hosted SearXNG for better, stabler results.
SEARXNG_URL=

# GitHub MCP (repos, PRs, issues, code search). Set a PAT to enable.
GITHUB_TOKEN=

# Supabase MCP (database, migrations, functions) — seeded READ-ONLY.
# Personal access token from supabase.com/dashboard/account/tokens.
SUPABASE_ACCESS_TOKEN=
# Optional: lock the MCP to a single project.
SUPABASE_PROJECT_REF=

# Extra/custom MCP servers: create native/mcp.json with the same shape as
# opencode.json's "mcp" block; entries there win over the seeded defaults.
