# ============================================================================
# MONOLITH — native (no-Docker) OpenWork launcher config.
# Copy to `native\.env` and fill in. This file is committed; `.env` is NOT.
# Generate a token with:  node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# ============================================================================

# ---- OpenWork engine (openwork-server + opencode) --------------------------
# Shared secret between the built UI and the local engine (any random string).
OPENWORK_TOKEN=change-me-client-token
OPENWORK_HOST_TOKEN=change-me-host-token
# Where the agent does its work (files it reads/writes). Default: native\workspace
# OPENWORK_WORKSPACE=C:\Users\Yash\Downloads\MONOLITH\native\workspace

# Ports (change only if something else already uses them).
OPENWORK_PORT=8787
OPENCODE_PORT=4096
UI_PORT=8080

# Repoint the OpenCode model catalog off OpenWork's mirror to the public default.
OPENCODE_MODELS_URL=https://models.dev/

# Pin the published orchestrator (0.17.8 is the known-good published version).
ORCHESTRATOR_VERSION=0.17.8

# ---- Local Ollama (default, private, no keys) ------------------------------
OLLAMA_URL=http://localhost:11434/v1
# The model pulled + used as the default. Pick one you can run on this PC.
OLLAMA_MODEL=qwen2.5-coder:7b

# ---- Ollama Cloud pool (optional big-model fallback) -----------------------
# The local round-robin proxy rotates these keys across OLLAMA_POOL_BASE.
# Leave all blank to disable the cloud pool entirely (local Ollama still works).
# SECURITY: real keys go in native\.env only — never commit them.
POOL_PORT=11435
OLLAMA_POOL_BASE=https://ollama.com/v1
OLLAMA_POOL_MODEL=gpt-oss:120b
OLLAMA_KEY_1=
OLLAMA_KEY_2=
OLLAMA_KEY_3=
OLLAMA_KEY_4=
OLLAMA_KEY_5=
OLLAMA_KEY_6=
OLLAMA_KEY_7=
OLLAMA_KEY_8=
OLLAMA_KEY_9=
OLLAMA_KEY_10=
OLLAMA_KEY_11=
OLLAMA_KEY_12=
OLLAMA_KEY_13=
OLLAMA_KEY_14=

# ---- Optional branding -----------------------------------------------------
# Set to rebrand the browser tab title (blank = keep "OpenWork").
PRODUCT_NAME=
