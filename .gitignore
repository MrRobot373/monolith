# Secrets & runtime state
.env
data/
**/data/
backups/

# Native (no-Docker) launcher: secrets, per-run state, chosen workspace, built UI
native/.env
native/.run/
native/workspace/

# Dependencies & build output (openwork/apps/app source IS tracked — we modify it;
# see the plan: MONOLITH's Cowork UI is built from this source in both deploy paths)
node_modules/
openwork/apps/app/dist/
.turbo/
.pnpm-store/

# Evaluation sandboxes are throwaway workspaces; results/ IS tracked
evals/sandboxes/

# Independence-program orchestrator: engine/opencode source IS tracked (vendored,
# git-history stripped — see monolith-independence-program notes); its
# node_modules is already covered by the generic rule above. Runtime state:
.monolith-data/

# Claude Code project tooling state (MCP config, skills cache) — local dev
# environment, not MONOLITH product source.
.mcp.json
skills-lock.json
/.agents/
/agent/
/.claude/

# OS / editor cruft
Thumbs.db
.DS_Store
*.log
