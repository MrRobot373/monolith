# ---- MONOLITH environment — copy to `.env` and fill in --------------------
# Generate random secrets, e.g.:  openssl rand -hex 24

# Public address. Local: leave as ":80". Production: your domain (enables HTTPS).
MONOLITH_SITE_ADDRESS=:80
# ACME_EMAIL=you@yourco.com

# ---- OpenWork workspace tokens --------------------------------------------
OPENWORK_TOKEN=change-me-client-token
OPENWORK_HOST_TOKEN=change-me-host-token
OPENWORK_APPROVAL_MODE=manual            # manual | auto

# ---- LiteLLM gateway ------------------------------------------------------
LITELLM_MASTER_KEY=sk-change-me-master
LITELLM_SALT_KEY=change-me-salt-DO-NOT-CHANGE-AFTER-FIRST-BOOT
LITELLM_DB_PASSWORD=change-me-db-password
# Key the workspace uses to call the gateway. Blank = use master key (fine for Phase 1;
# Phase 2 mints a per-user virtual key with a budget instead).
OPENWORK_LITELLM_KEY=

# ---- Cloud provider keys (fill ONE you use) -------------------------------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Google Gemini — real free tier. Use ONE legitimate key from your own account.
GEMINI_API_KEY=
